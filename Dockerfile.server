# One image for every in-cluster role of panko-server (gateway, controller with the embedded
# Metacontroller, endpoint, mirror, runner, setup). The pod's args select the role.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=$VERSION" -o /out/panko-server ./cmd/panko-server

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /out/panko-server /usr/local/bin/panko-server
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/panko-server"]
