FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/runner ./cmd/runner

FROM ghcr.io/opentofu/opentofu:1.11.7-minimal AS tofu
FROM alpine:3.23 AS providers
RUN apk add --no-cache ca-certificates
COPY --from=tofu /usr/local/bin/tofu /usr/local/bin/tofu
WORKDIR /opt/module
COPY terraform/database/ ./
# Add the verified target-platform h1 checksums before using the offline mirror.
RUN tofu init -backend=false -input=false \
    && tofu providers mirror /opt/provider-mirror \
    && rm -rf .terraform

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=tofu /usr/local/bin/tofu /usr/local/bin/tofu
COPY --from=providers /opt/module /opt/module
COPY --from=providers /opt/provider-mirror /opt/provider-mirror
COPY --from=build /out/runner /usr/local/bin/runner
COPY runner/tofurc /etc/tofurc
ENV TF_CLI_CONFIG_FILE=/etc/tofurc TF_IN_AUTOMATION=1 TF_INPUT=0
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/runner"]
