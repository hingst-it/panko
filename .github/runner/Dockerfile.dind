FROM docker:29.9.2-dind@sha256:9e79b879b177fbd72c34376a3dd3d91747da5db49e1f560f76aea59561471977
RUN apk add --no-cache e2fsprogs util-linux
COPY .github/runner/dockerd-kata.sh /usr/local/bin/dockerd-kata
RUN chmod 0755 /usr/local/bin/dockerd-kata
ENTRYPOINT ["/usr/local/bin/dockerd-kata"]
CMD ["dockerd"]
