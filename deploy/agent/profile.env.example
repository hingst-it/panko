# /etc/panko-agent/profiles/<team>.env — mode 0600. Only these values reach OpenTofu for the team's
# resources; the agent's own environment does not.
# State backend (S3) credentials:
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
# Provider settings the module reads, for example:
# PGPASSWORD=...
# TF_VAR_endpoint=http://moto:5000
