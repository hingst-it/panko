# /etc/panko-agent/agent.env — the agent's own settings; team credentials live in profiles/<team>.env.
PANKO_ENDPOINT=https://panko.example.com:30443
PANKO_ENDPOINT_CA=/etc/panko-agent/ca.crt
PANKO_AGENT_TOKEN_FILE=/etc/panko-agent/token
PANKO_POOL=edge
PANKO_PROFILES=/etc/panko-agent/profiles
PANKO_WORK=/var/lib/panko-agent
# Optional: an SSH key for a private module repository, with the repository server's host keys.
# GIT_SSH_COMMAND=ssh -i /etc/panko-agent/module-key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/panko-agent/known_hosts -o StrictHostKeyChecking=yes
