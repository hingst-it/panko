FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH
ARG COMPONENT=gateway
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/panko ./cmd/$COMPONENT

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=build /out/panko /usr/local/bin/panko
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/panko"]
